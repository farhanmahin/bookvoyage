    <!-- INTERACTIVE JAVASCRIPT LOGIC -->
    <script>
        // Book Data Array
        const booksData = [
            { id: 0, title: "আরেক ফাল্গুন", originalPrice: 180, discountedPrice: 144 },
            { id: 1, title: "একুশে ফেব্রুয়ারি", originalPrice: 150, discountedPrice: 120 },
            { id: 2, title: "আর কত দিন", originalPrice: 160, discountedPrice: 128 }
        ];

        // Mobile Menu Toggle
        const menuBtn = document.getElementById('menu-btn');
        const menu = document.getElementById('menu');
        menuBtn.addEventListener('click', () => {
            menu.classList.toggle('hidden');
        });

        // Set Current Year
        document.getElementById('year').textContent = new Date().getFullYear();

        // Dynamic Calculation & Preview Update
        function calculateTotal() {
            const checkboxes = document.querySelectorAll('.book-checkbox');
            let subtotal = 0;
            let selectedCount = 0;
            let memoBookListHTML = '';

            checkboxes.forEach((cb) => {
                if (cb.checked) {
                    const book = booksData[cb.value];
                    subtotal += book.discountedPrice;
                    selectedCount++;
                    memoBookListHTML += `
                        <li class="flex justify-between items-center py-1">
                            <span>• ${book.title}</span>
                            <span class="font-bold">৳${book.discountedPrice}</span>
                        </li>
                    `;
                }
            });

            if (selectedCount === 0) {
                memoBookListHTML = '<li class="text-red-500 italic py-1">কোনো বই বাছাই করা হয়নি</li>';
            }

            // Subtotal Update
            document.getElementById('selectedSubtotal').textContent = `৳${subtotal}`;
            document.getElementById('memoSubtotal').textContent = `৳${subtotal}`;
            document.getElementById('memoCount').textContent = `${selectedCount} টি`;
            document.getElementById('memoBookList').innerHTML = memoBookListHTML;

            // Delivery Fee Calculation based on Courier & District Selection
            const courierMethod = document.querySelector('input[name="courierMethod"]:checked').value;
            const district = document.getElementById('custDistrict').value;
            let deliveryFee = 60; // Default Sundarban or Dhaka city
            let courierName = 'সুন্দরবন কুরিয়ার';

            if (courierMethod === 'sundarban') {
                deliveryFee = 60;
                courierName = 'সুন্দরবন কুরিয়ার (সারাদেশ)';
            } else if (courierMethod === 'cod') {
                if (district === 'dhaka_inside') {
                    deliveryFee = 60;
                    courierName = 'ক্যাশ অন ডেলিভারি (ঢাকা সিটি)';
                } else if (district === 'dhaka_outside') {
                    deliveryFee = 110;
                    courierName = 'ক্যাশ অন ডেলিভারি (ঢাকার বাহিরে)';
                } else if (district !== '') {
                    deliveryFee = 110;
                    courierName = 'ক্যাশ অন ডেলিভারি (অন্যান্য জেলা)';
                } else {
                    deliveryFee = 60;
                    courierName = 'ক্যাশ অন ডেলিভারি';
                }
            }

            document.getElementById('memoCourierName').textContent = courierName;
            document.getElementById('memoDeliveryFee').textContent = `৳${deliveryFee}`;

            // Grand Total
            const grandTotal = subtotal + (selectedCount > 0 ? deliveryFee : 0);
            document.getElementById('memoTotal').textContent = `৳${grandTotal}`;

            updatePreview();
        }

        // Live Memo Text Updates
        function updatePreview() {
            const name = document.getElementById('custName').value.trim();
            const phone = document.getElementById('custPhone').value.trim();
            const districtSelect = document.getElementById('custDistrict');
            const districtText = districtSelect.options[districtSelect.selectedIndex] ? districtSelect.options[districtSelect.selectedIndex].text : '';
            const address = document.getElementById('custAddress').value.trim();

            document.getElementById('memoName').textContent = name || '---';
            document.getElementById('memoPhone').textContent = phone || '---';
            
            let fullAddressText = '---';
            if (address || (districtText && !districtSelect.disabled && districtSelect.value !== '')) {
                fullAddressText = `${address ? address + ', ' : ''}${districtText && districtSelect.value !== '' ? districtText : ''}`;
            }
            document.getElementById('memoAddress').textContent = fullAddressText;
        }

        // Form Submit Handler & Modal Trigger
        function handleOrderSubmit(event) {
            event.preventDefault();

            const checkboxes = document.querySelectorAll('.book-checkbox:checked');
            if (checkboxes.length === 0) {
                alert('অনুগ্রহ করে অন্তত একটি বই বাছাই করুন!');
                return;
            }

            const totalPay = document.getElementById('memoTotal').textContent;
            const randomId = 'BV-' + Math.floor(10000 + Math.random() * 90000);

            document.getElementById('modalOrderId').textContent = randomId;
            document.getElementById('modalTotalPay').textContent = totalPay;

            // Show Modal
            document.getElementById('successModal').classList.remove('hidden');
        }

        // Close Modal
        function closeModal() {
            document.getElementById('successModal').classList.add('hidden');
            window.location.href = "index.html";
        }

        // Initialize Calculation on Load
        window.onload = function() {
            calculateTotal();
        };
    </script>
